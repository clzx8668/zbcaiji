# === LLM 配置（可选，用于 Crawl4AI 智能提取和搜索分析） ===
# 支持 OpenAI 兼容接口（OpenAI / DeepSeek / 通义千问 等）
#
# DeepSeek 示例（推荐）:
# LLM_API_KEY=sk-your-deepseek-key
# LLM_API_BASE=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
#
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# === 浏览器引擎配置 ===
# 可选值: playwright, camoufox
BROWSER_ENGINE=playwright

# === 代理配置（可选） ===
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# === 爬取配置 ===
# 每次爬取间隔（秒），会在该范围内随机
CRAWL_INTERVAL_MIN=2
CRAWL_INTERVAL_MAX=10

# 单次爬取超时（秒）
CRAWL_TIMEOUT=120

# 单个站点单次任务总时长上限（秒），超时自动终止，防止后台任务卡死
CRAWL_MAX_SECONDS=900

# 最大重试次数
MAX_RETRIES=3

# 结果列表最大翻页数
MAX_PAGES=5

# === LLM 超时配置 ===
LLM_TIMEOUT=30

# === 数据库配置 ===
DATABASE_PATH=data/bid_scraper.db

# === 缓存配置 ===
SEARCH_ANALYSIS_CACHE_DIR=data/cache/search_analysis

# === 日志配置 ===
LOG_LEVEL=INFO
LOG_RETENTION=30 days

# === Web 管理后台配置 ===
# 管理后台登录凭据
WEB_ADMIN_USER=admin
WEB_ADMIN_PASS=admin123

# Flask 密钥（生产环境请修改为随机字符串）
FLASK_SECRET_KEY=change-me-to-a-random-string

# === 通知配置（可选） ===
# 钉钉机器人 Webhook
# DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx

# 企业微信机器人 Webhook
# WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
